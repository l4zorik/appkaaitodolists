{
  "expo": {
    "name": "tudodo",
    "slug": "tudodo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.tudodo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "versionCode": 1
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "tudodo-project-id"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}