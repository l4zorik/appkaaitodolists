{
  "cli": {
    "version": ">= 5.1.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:assembleRelease",
        "track": "production"
      },
      "ios": {
        "buildConfiguration": "Release",
        "track": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      },
      "ios": {
        "appleTeamId": "YOUR_APPLE_TEAM_ID",
        "ascAppId": "YOUR_ASC_APP_ID"
      }
    }
  }
}